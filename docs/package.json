{
  "name": "@parity/product-sdk-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "serve out",
    "docs:extract": "tsx scripts/extract.ts",
    "docs:render": "tsx scripts/generate-api.ts",
    "docs:generate": "pnpm docs:extract && pnpm docs:render"
  },
  "dependencies": {
    "next": "^16.2.9",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.2",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.16",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typedoc": "0.28.19",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.11",
      "mermaid": ">=11.15.0",
      "uuid": ">=11.1.1",
      "markdown-it": ">=14.2.0",
      "linkify-it": ">=5.0.1",
      "brace-expansion": ">=5.0.6",
      "fast-uri": ">=3.1.2",
      "postcss": ">=8.5.10"
    }
  }
}
