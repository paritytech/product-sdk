{
    "name": "@parity/product-sdk-chat",
    "version": "0.0.0",
    "description": "Build a chat product: rooms the host draws through Chat Extension v2, served from the product's own messages",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./testing": {
            "import": "./dist/testing.js",
            "types": "./dist/testing.d.ts"
        }
    },
    "files": ["dist", "src"],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@parity/product-sdk-host": "workspace:*",
        "@parity/product-sdk-local-storage": "workspace:*",
        "@parity/product-sdk-logger": "workspace:*",
        "@parity/product-sdk-utils": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsup": "catalog:",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    },
    "license": "Apache-2.0"
}
