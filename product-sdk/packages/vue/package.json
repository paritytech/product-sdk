{
    "name": "@parity/product-sdk-vue",
    "version": "0.0.0",
    "description": "Vue 3 composables for Polkadot apps on TanStack Query: chain queries, accounts, transactions, contracts, host features, chat, statements, payments and cloud storage",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist"],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@parity/product-sdk-hooks-core": "workspace:*",
        "@parity/product-sdk-host": "workspace:*"
    },
    "peerDependencies": {
        "@tanstack/vue-query": "^5.0.0",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@tanstack/vue-query": "^5.101.2",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^26.1.0",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "^3.5.39"
    },
    "keywords": ["polkadot", "parity", "sdk", "vue", "composables", "tanstack-query", "web3"],
    "license": "Apache-2.0"
}
