{
    "name": "@parity/product-sdk-hooks-core",
    "version": "0.0.0",
    "description": "Framework-agnostic runtime behind @parity/product-sdk-react and @parity/product-sdk-vue: host detection, chain clients, signers, transactions, contracts, chat, statements, payments and cloud storage for Polkadot apps",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist"],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@parity/product-sdk-address": "workspace:*",
        "@parity/product-sdk-cloud-storage": "workspace:*",
        "@parity/product-sdk-contracts": "workspace:*",
        "@parity/product-sdk-host": "workspace:*",
        "@parity/product-sdk-signer": "workspace:*",
        "@parity/product-sdk-statement-store": "workspace:*",
        "@parity/product-sdk-tx": "workspace:*",
        "@parity/product-sdk-utils": "workspace:*",
        "@parity/truapi": "catalog:",
        "@polkadot-api/signers-common": "catalog:",
        "polkadot-api": "catalog:"
    },
    "devDependencies": {
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "keywords": ["polkadot", "parity", "sdk", "hooks", "web3"],
    "license": "Apache-2.0"
}
