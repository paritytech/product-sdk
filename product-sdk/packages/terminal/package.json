{
    "name": "@parity/product-sdk-terminal",
    "description": "QR code login and signing for CLI/terminal apps via Polkadot mobile wallet pairing",
    "version": "0.13.2",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist"],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "pretest": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@parity/product-sdk-host": "workspace:*",
        "@parity/product-sdk-keys": "workspace:*",
        "@parity/product-sdk-logger": "workspace:*",
        "@parity/product-sdk-signer": "workspace:*",
        "@parity/truapi": "catalog:",
        "@parity/truapi-host": "catalog:",
        "@polkadot-api/signers-common": "catalog:",
        "@polkadot-api/utils": "^0.4.0",
        "neverthrow": "^8.2.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.5",
        "polkadot-api": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "Apache-2.0"
}
