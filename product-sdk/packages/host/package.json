{
    "name": "@parity/product-sdk-host",
    "version": "0.18.0",
    "description": "Host container detection and storage access for Polkadot Desktop and Mobile environments",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./testing": {
            "import": "./dist/testing.js",
            "types": "./dist/testing.d.ts"
        }
    },
    "files": ["dist", "src"],
    "scripts": {
        "build": "tsup",
        "test": "vitest",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@parity/product-sdk-logger": "workspace:*",
        "@parity/product-sdk-errors": "workspace:*",
        "@parity/result": "workspace:*",
        "@parity/truapi": "catalog:",
        "@polkadot-api/json-rpc-provider": "catalog:",
        "@polkadot-api/substrate-bindings": "catalog:",
        "neverthrow": "^8.2.0",
        "polkadot-api": "catalog:"
    },
    "devDependencies": {
        "tsup": "catalog:",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    },
    "license": "Apache-2.0"
}
