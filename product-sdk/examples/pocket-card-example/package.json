{
    "name": "@parity/product-sdk-pocket-card-example",
    "version": "0.0.6",
    "private": true,
    "type": "module",
    "description": "Worker example: draws a live Pocket card and generates its approval-sheet faces from the same module",
    "scripts": {
        "build": "pnpm faces && pnpm bundle && node scripts/check-bundle.mjs",
        "bundle": "esbuild src/worker.tsx --bundle --outfile=dist/worker.js --format=esm --target=es2022 --minify --jsx=automatic",
        "faces": "esbuild src/write-faces.tsx --bundle --outfile=dist/write-faces.mjs --format=esm --platform=node --target=es2022 --jsx=automatic && node dist/write-faces.mjs",
        "test": "vitest",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@parity/product-sdk-host": "workspace:*",
        "@parity/product-sdk-renderer": "workspace:*",
        "@parity/product-sdk-react-renderer": "workspace:*",
        "react": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "^0.28.1",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "@types/react": "^19.0.0"
    }
}
